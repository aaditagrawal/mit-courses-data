{
  "name": "course-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts}\" \"*.{ts,json,jsonc}\" \"!branch-json/**\" \"!degree-json/**\" \"!tools/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts}\" \"*.{ts,json,jsonc}\" \"!branch-json/**\" \"!degree-json/**\" \"!tools/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "pages:build": "bunx @cloudflare/next-on-pages",
    "pages:deploy": "bun run pages:build && wrangler pages deploy .vercel/output/static",
    "pages:preview": "bun run pages:build && wrangler pages dev .vercel/output/static",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@stylexjs/stylex": "0.19.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.64.0",
    "minisearch": "^7.2.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vis-data": "^8.0.6",
    "vis-network": "^10.1.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@oxlint/plugins": "^1.90.0",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "10.1.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "@tootallnate/once": "^2.0.1",
    "ajv": "^8.18.0",
    "cookie": "^0.7.2",
    "esbuild": "^0.28.1",
    "path-to-regexp": "^6.3.0",
    "tar": "^7.5.22",
    "undici": "^6.29.1",
    "ws": "^8.21.0",
    "zod": "^4.6.6"
  },
  "packageManager": "bun@1.4.2"
}
