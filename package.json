{
  "name": "course-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && bun run typecheck",
    "start": "next start",
    "generate:graph-layout": "bun run scripts/generate-graph-layout.ts",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts}\" \"*.{ts,json,jsonc}\" \"!branch-json/**\" \"!degree-json/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts}\" \"*.{ts,json,jsonc}\" \"!branch-json/**\" \"!degree-json/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "next typegen && bunx --bun tsrs --noEmit",
    "workers:build": "vite build && bun run typecheck",
    "workers:preview": "bun run workers:build && wrangler dev",
    "workers:deploy": "bun run workers:build && wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "graphology": "^0.26.0",
    "lucide-react": "^1.60.0",
    "minisearch": "^7.2.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sigma": "^4.0.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-rsc": "^0.5.38",
    "graphology-layout-forceatlas2": "^0.10.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vinext": "^1.2.1",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "fflate@>=0.7.0 <0.7.5": "0.7.5"
  }
}
