{
  "name": "course-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts}\" \"*.{ts,json,jsonc}\" \"!branch-json/**\" \"!degree-json/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts}\" \"*.{ts,json,jsonc}\" \"!branch-json/**\" \"!degree-json/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "lint": "oxlint . --ignore-path .gitignore --react-plugin --nextjs-plugin --jsx-a11y-plugin --import-plugin",
    "lint:fix": "bun run lint -- --fix",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "bun run pages:build && wrangler pages deploy .vercel/output/static",
    "pages:preview": "bun run pages:build && wrangler pages dev .vercel/output/static"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.30.0",
    "minisearch": "^7.2.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}
